# Copy to .env before running docker compose. These are local-dev-only
# defaults -- see docs/03-kubernetes-deployment.md for how the real system
# handles this via ConfigMap (non-sensitive) vs Secret (credentials, and
# explicitly NOT encrypted at rest by default, called out there on purpose).

# --- cross-service ---
# Stand-in for Istio's AuthorizationPolicy service-identity matrix (docs/04)
# until the mesh phase of this project exists -- see shared/gestalt_shared/internal_auth.py.
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me
JWT_ISSUER=gestalt-commerce-auth
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

# --- mariadb (single instance locally, per-service db+user, mirrors the
# single `mariadb` StatefulSet in docs/03; must match infra/mariadb-init/01-init.sql) ---
MARIADB_ROOT_PASSWORD=rootpass
MARIADB_HOST=mariadb
MARIADB_PORT=3306

MARIADB_AUTH_DB=auth_db
MARIADB_AUTH_USER=auth_svc
MARIADB_AUTH_PASSWORD=auth_pass

MARIADB_CATALOG_DB=catalog_db
MARIADB_CATALOG_USER=catalog_svc
MARIADB_CATALOG_PASSWORD=catalog_pass

MARIADB_ORDERS_DB=orders_db
MARIADB_ORDERS_USER=order_svc
MARIADB_ORDERS_PASSWORD=order_pass

# --- redis: one instance per owning service, matching the architecture
# diagram in README.md (CatCache / CartStore / PayIdem are separate boxes) ---
REDIS_AUTH_HOST=redis-auth
REDIS_CATALOG_HOST=redis-catalog
REDIS_CART_HOST=redis-cart
REDIS_PAYMENT_HOST=redis-payment
REDIS_PORT=6379

# --- mongodb (review-service) ---
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=mongopass
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_REVIEW_DB=review_db

# --- kafka ---
KAFKA_BROKERS=kafka:9092
KAFKA_ORDER_EVENTS_TOPIC=order-events
KAFKA_ORDER_EVENTS_DLQ_TOPIC=order-events-dlq

# --- order-service ---
DELIVERY_SIMULATION_DELAY_SECONDS=30
DELIVERY_CHECK_INTERVAL_SECONDS=10

# --- notification-service ---
SLACK_WEBHOOK_URL=

# --- payment-service chaos knobs (docs/02-api-contracts.md) ---
PAYMENT_FAILURE_RATE=0.0
PAYMENT_LATENCY_MS_MIN=0
PAYMENT_LATENCY_MS_MAX=0

LOG_LEVEL=info
